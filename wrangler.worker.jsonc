{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fox-referrals-api",
  "account_id": "75d4cc849d22526730a76a2f200446d7",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "triggers": { "crons": ["* * * * *"] },
  "ratelimits": [{
    "name": "CLAIM_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 60, "period": 60 }
  }],
  "vars": {
    "APP_ENV": "staging",
    "PUBLIC_ORIGIN": "https://fox-referrals.pages.dev",
    "QB_ENABLED": "true",
    "QB_REDIRECT_URI": "https://fox-referrals.pages.dev/api/quickbooks/callback",
    "QB_REALM_ID": "9341458457635639",
    "QB_MINOR_VERSION": "75",
    "QB_TIME_ZONE": "America/New_York",
    "ACCESS_TEAM_DOMAIN": "https://fox-referrals-staging.cloudflareaccess.com",
    "ACCESS_AUD": "2a798d83b3680f623089d2e24e509d936d9b1a088349a85caf0db2b1799e076a",
    "ACCESS_ADMIN_SUB": "c6827536-6aa4-596b-9f0b-95865a0212b3"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "fox-referrals",
    "database_id": "c141811c-68fe-4e89-bb88-739f2449442c",
    "migrations_dir": "migrations"
  }]
}
