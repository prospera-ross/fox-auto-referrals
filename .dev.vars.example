# LOCAL WINDOWS ONLY. Copy via npm.cmd run setup:local.
# Do not commit .dev.vars. Fill credentials in your editor, never in chat.
APP_ENV="local"
PUBLIC_ORIGIN="http://localhost:8788"
QB_ENABLED="false"
QB_TIME_ZONE="America/New_York"
QB_MINOR_VERSION="75"
QB_CLIENT_ID=""
QB_CLIENT_SECRET=""
QB_WEBHOOK_VERIFIER=""
QB_TOKEN_KEY=""
QB_REALM_ID=""
# Complete these only after choosing the public HTTPS hostname and Access app.
QB_REDIRECT_URI=""
ACCESS_TEAM_DOMAIN=""
ACCESS_AUD=""
ACCESS_ADMIN_SUB=""
